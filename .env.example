# ==================================================
# The 6th Tool - Production Environment Variables
# ==================================================
# Copy this file to .env and fill in the values

# Database (Automatically provided by Replit)
DATABASE_URL=postgresql://...

# Session Secret (Generate a secure random string)
SESSION_SECRET=your-secure-random-string-at-least-32-chars

# Stripe (Managed by Replit Stripe Connector)
# These are automatically provided when you connect Stripe via Replit
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# Stripe webhook secret is managed by stripe-replit-sync

# Email Service (Optional - for transactional emails)
# EMAIL_SERVER=smtp://user:password@smtp.example.com:587
# EMAIL_FROM=noreply@the6thtool.com

# Error Monitoring (Optional - for Sentry integration)
# SENTRY_DSN=https://...@sentry.io/...
# VITE_SENTRY_DSN=https://...@sentry.io/...

# Production Deployment
# These are automatically set by Replit in production
# NODE_ENV=production
# REPLIT_DEPLOYMENT=1
# REPLIT_DOMAINS=your-app.replit.app

# ==================================================
# Development vs Production Notes:
# ==================================================
# 
# Development:
# - Stripe uses test mode keys (automatically via Replit connector)
# - Database uses development PostgreSQL instance
# - Hot reload enabled
#
# Production:
# - Stripe uses live mode keys
# - Database uses production PostgreSQL instance
# - Static assets served from built bundle
# - HTTPS enforced
#
# ==================================================
# Security Checklist:
# ==================================================
# [ ] SESSION_SECRET is unique and secure (32+ chars)
# [ ] Stripe connector configured for both dev and prod
# [ ] Database backups enabled
# [ ] CORS configured for production domains only
# [ ] Rate limiting enabled on auth endpoints
